{
  "$comment": "Single source of truth for the incident domain rules (CONTEXT-nexova.es.md — Gestor de Incidencias Centralizado). Read by incidents_analyzer (Python: CLI scripts + API) and by types/incidents.ts (backoffice). `categories` and `branches` are the exact values the manager accepts; `csvCategories` / `csvStatuses` are the helpdesk CSV vocabulary (CSV analysis) and the csv*Map entries translate it. Change a rule here, never in a copy.",
  "categories": [
    "technical_failure",
    "process_error",
    "client_complaint",
    "candidate_issue",
    "staff_issue",
    "sla_breach",
    "data_quality",
    "other"
  ],
  "statuses": [
    "open",
    "in_progress",
    "resolved",
    "discarded"
  ],
  "origins": [
    "customer",
    "branch",
    "internal"
  ],
  "branches": [
    {
      "value": "central",
      "label": "Central — Sede Valencia"
    },
    {
      "value": "valencia_operations",
      "label": "Valencia — Operaciones"
    },
    {
      "value": "miami_office",
      "label": "Miami Office"
    },
    {
      "value": "remote",
      "label": "Remoto (empleado sin sede fija)"
    }
  ],
  "defaultBranch": "central",
  "transitions": {
    "open": [
      "in_progress",
      "discarded"
    ],
    "in_progress": [
      "resolved",
      "discarded"
    ],
    "resolved": [],
    "discarded": []
  },
  "editableStatuses": [
    "open",
    "in_progress"
  ],
  "csvStatuses": [
    "OPEN",
    "CLOSED",
    "DISCARDED"
  ],
  "csvStatusMap": {
    "OPEN": "open",
    "CLOSED": "resolved",
    "DISCARDED": "discarded"
  },
  "csvCategories": [
    "TECHNICAL",
    "BILLING",
    "ACCESS",
    "HR_QUERY",
    "COMPLAINT"
  ],
  "csvCategoryMap": {
    "TECHNICAL": "technical_failure",
    "BILLING": "process_error",
    "ACCESS": "technical_failure",
    "HR_QUERY": "process_error",
    "COMPLAINT": "client_complaint"
  },
  "patterns": {
    "id": "^NXV-\\d{6}$",
    "agentId": "^AGT-\\d{2}$"
  },
  "limits": {
    "titleMin": 3,
    "titleMax": 120,
    "clientCompanyMax": 120,
    "descriptionMin": 5,
    "descriptionMax": 1000,
    "discardReasonMin": 5,
    "discardReasonMax": 300,
    "scoreMin": 1,
    "scoreMax": 5
  }
}
