# Supabase (reporting pipeline)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_secret_key

# Qdrant (local Docker — see docker-compose.yml)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embeddings — 4Geeks gateway (dedicated embedding model; do NOT reuse generation model)
EMBEDDING_MODEL_ID=downtown-miami/openrouter/perplexity/pplx-embed-v1-0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=your_4geeks_api_key
EMBEDDING_BASE_URL=https://llm.4geeks.ai

# Generation — 4Geeks gateway (separate chat/completion model)
GENERATION_MODEL_ID=downtown-miami/groq/llama-3.1-8b-instant
GENERATION_API_KEY=your_4geeks_api_key
GENERATION_BASE_URL=https://llm.4geeks.ai

# Optional legacy fallback used by other milestones
GROQ_API_KEY=your_groq_key_here
OPENAI_API_KEY=your_4geeks_api_key
OPENAI_BASE_URL=https://llm.4geeks.ai
