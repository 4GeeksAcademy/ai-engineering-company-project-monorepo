# ======================================================================
# TrackFlow — Environment template
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# For Docker development, see `.env.docker` for a ready-to-use template
# with SQLite (no external Postgres needed).
#
# Docker Compose automatically loads the `.env` file from the repo root.
# NEVER commit the real .env — it is in .gitignore. Credentials belong
# exclusively in .env, not in Dockerfiles or docker-compose.yml.
# ======================================================================

JWT_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres?sslmode=require
# Optional separate Supabase destination for telemetry; never reuse inventory storage.
TELEMETRY_DATABASE_URL=
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=TrackFlow <no-reply@your-verified-domain.com>

# --- Backoffice URL (for password reset links) ------------------------
# Dev: http://localhost:3001 · Prod: https://admin.yourdomain.com
BACKOFFICE_URL=http://localhost:3001

# --- CORS (comma-separated browser origins for production) ------------
# e.g. "https://trackflow.com,https://admin.trackflow.com"
CORS_ORIGINS=

# --- Inter-service upstream (Docker) ----------------------------------
# The UI server proxies /api, /auth, /users, /profiles, /inventory and
# /suppliers to the backend using this URL. Inside Docker Compose the
# other service resolves by its service name `api`.
BACKEND_UPSTREAM=http://api:8000

# --- UI ports (host-facing) ------------------------------------------
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001

# --- UI mode ----------------------------------------------------------
TRACKFLOW_UI_MODE=dev

# --- Next.js public API URLs -----------------------------------------
# Leave blank to use the server-side proxy (recommended in Docker).
# Only set if the browser must reach the API at a public base URL:
# e.g. https://api.trackflow.com
NEXT_PUBLIC_INCIDENTS_API_BASE_URL=
NEXT_PUBLIC_INVENTORY_API_URL=
