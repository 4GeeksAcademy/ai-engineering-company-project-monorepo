# Shared Redis broker/backend for API + Celery workers + Flower
REDIS_URL=redis://localhost:6379/0

# Central API telemetry stub (services/api/config.py). Not a redirect.
TELEMETRY_ENDPOINT=http://127.0.0.1:8000/telemetry/events

# Backoffice Vite reads NEXT_PUBLIC_TELEMETRY_ENDPOINT from uis/backoffice/.env.local
# (envPrefix allows NEXT_PUBLIC_). Copy the line below into that file.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://127.0.0.1:8000/telemetry/events
