# ======================================================================
# TrackFlow — Docker development environment (template)
#
# Copy to .env or use: docker compose --env-file .env.docker up
# ======================================================================

# --- Inter-service upstream -------------------------------------------
# The UI container proxies API traffic to the backend over the Docker
# network using the COMPOSE SERVICE NAME `api` (never localhost).
BACKEND_UPSTREAM=http://api:8000

# --- CORS (comma-separated origins) -----------------------------------
# Defaults (localhost:3000,3001) are baked into the API startup — no
# value needed in dev. Override for production domains.
CORS_ORIGINS=

# --- API / JWT -------------------------------------------------------
JWT_SECRET_KEY=insecure-dev-secret-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
ALLOW_PASSWORD_RESET_CONSOLE_FALLBACK=true

# --- Database --------------------------------------------------------
# Local development: SQLite (no external Postgres needed).
# The API persists TinyDB files under services/api/data/ which is
# git-ignored but persisted via the named volume.
DATABASE_URL=sqlite:///./services/api/data/inventory.db
TELEMETRY_ENABLED=false
TELEMETRY_DATABASE_URL=

# --- Resend (dev: console fallback) ----------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=TrackFlow <dev@trackflow.local>

# --- Backoffice URL (for password reset links) ------------------------
# Browser-facing URL: the user opens the backoffice on :3001.
BACKOFFICE_URL=http://localhost:3001

# --- UI ports (host-facing) ------------------------------------------
# website → 3000, backoffice → 3001 (per ticket #infra-40)
WEBSITE_PORT=3000
BACKOFFICE_PORT=3001

# --- UI runtime mode --------------------------------------------------
# dev (next dev, hot reload) | prod (next build && next start)
TRACKFLOW_UI_MODE=dev

# --- Next.js public API URLs -----------------------------------------
# The backoffice SPA calls the API through RELATIVE /api, /auth, ...
# paths, which the Next.js server proxies to ${BACKEND_UPSTREAM}
# (http://api:8000) by Docker service name. Leave these blank for the
# proxy flow; only set them if you serve the API at a public base URL
# (e.g. https://api.trackflow.com) instead of using the proxy.
NEXT_PUBLIC_INCIDENTS_API_BASE_URL=
NEXT_PUBLIC_INVENTORY_API_URL=

# --- Admin seed credentials (first-run only) -------------------------
TRACKFLOW_ADMIN_EMAIL=admin@trackflow.com
TRACKFLOW_ADMIN_PASSWORD=admin123
