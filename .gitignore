/audit

# Python bytecode and the uv-managed virtualenv
__pycache__/
*.py[cod]
.venv/

# Datos de cobertura de `uv run pytest --cov`
.coverage

# Local environment variables
.env

# Runtime data written by the current code
# scripts/analyze.py (CLI) exports here when run from the repository root
/results.csv
# services/api/store.py creates this TinyDB file when imported (override with TINYDB_PATH)
/services/api/db.json
# Incident embeddings (services/api/store.py), stored next to the TinyDB file
/services/api/db.embeddings.json
# data/pipelines/pipeline.py: snapshots JSON opcionales del reporte semanal (override con REPORTING_SNAPSHOT_DIR)
/data/process/reporting/
# scripts/nightly_export.py: backup diario de telemetry_events (lleva user_id/session_id; override con NIGHTLY_EXPORT_DIR)
/data/raw/telemetry_*.csv
/data/raw/.telemetry_*.csv.tmp

# Dependencias de Node (website, backoffice y app Next.js)
node_modules/
