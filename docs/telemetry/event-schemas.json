{
  "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Nexova Solutions - Catálogo de Esquemas de Telemetría",
    "description": "Especificación formal de validación para eventos de telemetría con Event Envelope uniforme y Allowlists estrictos.",
    "definitions": {
        "EventEnvelopeBase": {
            "type": "object",
            "required": [
            "eventId",
            "timestamp",
            "sessionId",
            "userId",
            "event_type",
            "schemaVersion",
            "requestId",
            "properties"
            ],
            "properties": {
                "eventId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                "description": "Identificador único global del evento (UUID v4)."
                },
                "timestamp": {
                "type": "string",
                "format": "date-time",
                "description": "Marca temporal en formato ISO 8601 UTC."
                },
                "sessionId": {
                "type": "string",
                "minLength": 8,
                "description": "Identificador único de la sesión del usuario o cliente."
                },
                "userId": {
                "type": ["string", "null"],
                "pattern": "^[a-f0-9]{64}$",
                "description": "Hash SHA-256 del identificador interno del usuario, o null si es pre-login/anónimo."
                },
                "event_type": {
                "type": "string",
                "description": "Tipo canónico del evento en taxonomía entidad_acción."
                },
                "schemaVersion": {
                "type": "string",
                "pattern": "^1\\.0\\.0$",
                "description": "Versión semántica del esquema del evento."
                },
                "requestId": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                "description": "ID de correlación distribuida propagado por HTTP headers (X-Request-ID)."
                },
                "properties": {
                "type": "object",
                "description": "Payload de datos del evento, restringido estrictamente por el allowlist específico."
                }
            }
        },
        "support_ticket_resolved": {
            "allOf": [
                { "$ref": "#/definitions/EventEnvelopeBase" },
                {
                    "type": "object",
                    "properties": {
                        "event_type": { "const": "support_ticket_resolved" },
                        "properties": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "ticket_id",
                                "resolution_time_minutes",
                                "channel",
                                "agent_id_hash",
                                "sla_breached"
                            ],
                            "properties": {
                                "ticket_id": {
                                    "type": "string",
                                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                                    "description": "Identificador único del ticket (UUID)."
                                },
                                "resolution_time_minutes": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Tiempo total transcurrido desde la creación hasta el cierre."
                                },
                                "channel": {
                                    "type": "string",
                                    "enum": ["chat", "email", "phone"],
                                    "description": "Canal de atención utilizado."
                                },
                                "agent_id_hash": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{64}$",
                                    "description": "Hash SHA-256 del ID del agente resolutor."
                                },
                                "sla_breached": {
                                    "type": "boolean",
                                    "description": "Indica si se superó el límite de 24h (1440 min)."
                                }
                            }
                        }
                    }
                }
            ]
        },
        "chatbot_issue_resolved": {
            "allOf": [
                { "$ref": "#/definitions/EventEnvelopeBase" },
                {
                    "type": "object",
                    "properties": {
                        "event_type": { "const": "chatbot_issue_resolved" },
                        "properties": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "conversation_id",
                                "category",
                                "message_count",
                                "resolution_type"
                            ],
                            "properties": {
                                "conversation_id": {
                                    "type": "string",
                                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                                },
                                "category": {
                                    "type": "string",
                                    "enum": ["tech_support", "billing", "onboarding", "general"]
                                },
                                "message_count": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "satisfaction_score": {
                                    "type": ["integer", "null"],
                                    "minimum": 1,
                                    "maximum": 5
                                },
                                "resolution_type": {
                                    "type": "string",
                                    "enum": ["faq_matched", "workflow_completed", "self_service"]
                                }
                            }
                        }
                    }
                }
            ]
        },
