# Backoffice — Nexova
#
# Variables de entorno para el frontend del backoffice (Next.js).
# Copia este archivo como .env.local y ajusta según tu entorno.

# Dónde reenvían los rewrites de next.config.mjs las llamadas a la API
# (/api, /auth, /users, /profiles). Por defecto, http://localhost:8000.
# API_PROXY_TARGET=http://localhost:8000

# URL base de la API que usa el navegador.
# Vacío (por defecto) = mismo origen, a través de los rewrites de arriba.
# En producción, si la API está en otro dominio, descomenta y ajusta:
# NEXT_PUBLIC_API_BASE_URL=https://api.nexova.com

# URL base de la API de inventario (rutas /inventory/*). Debe apuntar a tu backend en ejecución.
# El navegador llama siempre al mismo origen (/api/inventory/*) y next.config.mjs reenvía a esta URL.
# Si no la defines, se usa API_PROXY_TARGET (por defecto http://localhost:8000).
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000
