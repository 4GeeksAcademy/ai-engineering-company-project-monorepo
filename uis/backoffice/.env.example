# Direct URL of the inventory API (no trailing slash). The API's CORS_ORIGINS must include
# this app's origin. Leave empty to use the same-origin /api/inventory proxy instead.
NEXT_PUBLIC_INVENTORY_API_URL=

# Where TelemetryService sends event batches (POST). Same value as TELEMETRY_ENDPOINT in services/api/.env.
# Today it is the stub in the API (it validates and answers 200); later the real intake, with no frontend change.
# The API's CORS_ORIGINS must include this app's origin. Unset: telemetry is off and track() does nothing.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Optional: deployed version/commit, sent as app_version in frontend_error_captured (defaults to "dev").
# NEXT_PUBLIC_APP_VERSION=
