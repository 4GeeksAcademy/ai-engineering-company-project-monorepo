# ============================================
# .env.docker - uis/backoffice
# ============================================
# Configuración para ejecutar uis/backoffice dentro de Docker.
#
# NEXT_PUBLIC_* → Se usan en el NAVEGADOR (cliente)
#   - Deben apuntar a puertos publicados en el HOST (localhost:XXXX)
#
# INCIDENTS_API_INTERNAL_URL → Se usa en el SERVIDOR (Next.js API routes)
#   - Debe apuntar al nombre del servicio Docker (api-backend:8000)
#
# Uso: docker compose --env-file uis/backoffice/.env.docker up -d
# ============================================

# --- URLs para el navegador (cliente) ---
# Apuntan a los puertos publicados en el host
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8003

# --- URL para el servidor (Next.js API routes) ---
# Apunta al nombre del contenedor de la API via red Docker interna
INCIDENTS_API_INTERNAL_URL=http://api-backend:8000
# Telemetry endpoint (expuesto en host como localhost:8001)
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8001/telemetry/events
