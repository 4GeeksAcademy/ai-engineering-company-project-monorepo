# ============================================
# .env.docker - uis/website
# ============================================
# Configuración para ejecutar uis/website dentro de Docker.
# NEXT_PUBLIC_* se inyectan en BUILD time en Next.js.
# Para desarrollo con hot-reload, estas variables deben
# estar en el entorno de compilación.
#
# Uso: docker compose --env-file uis/website/.env.docker up -d
# ============================================

# URL de la API de inventario (expuesta en host como localhost:8003)
# El navegador del usuario accede a través del host, no del contenedor
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8003