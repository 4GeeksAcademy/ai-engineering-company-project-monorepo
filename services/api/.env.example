# Copy to .env (never commit .env). Generate a key with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: TinyDB files (defaults to services/api/data/*.json)
# SUPPLIERS_DB_PATH=data/suppliers.json
# USERS_DB_PATH=data/users.json

# Optional: allowed origins for the backoffice
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Password reset emails (Resend: https://resend.com/api-keys). Never commit a real key.
# In development onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=onboarding@resend.dev
# Base URL of the backoffice; the email links to {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=30

# Inventory (Supabase Postgres). Connect > Direct > Transaction pooler > URI (port 6543).
# Replace [YOUR-PASSWORD]; never commit the real value.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<region>.pooler.supabase.com:6543/postgres

# Optional: set to 0 to disable the in-process response caches (to measure "before" latency).
# CACHE_ENABLED=1
