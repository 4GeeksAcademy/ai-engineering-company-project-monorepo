#!/usr/bin/env bash
set -e

repo_root="$(git rev-parse --show-toplevel)"

if command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "Python is required to run the TrackFlow memory-bank guard." >&2
  exit 1
fi

"$PYTHON_BIN" "$repo_root/scripts/check_memory_bank.py" --cached
